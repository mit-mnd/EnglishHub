# Sao chép thành backend/.env rồi điền giá trị thật. File .env đã được .gitignore.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=EnglishLearningDB
DB_USERNAME=sa
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Sinh bằng PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=

# Chấm phát âm: mock (mặc định, không cần key) | azure
AI_SPEECH_PROVIDER=mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Thư mục lưu file tải lên (bản ghi âm học viên + media admin trong public-media/)
APP_STORAGE_DIR=./uploads
# Giới hạn upload audio/video bài học
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=52MB

APP_CORS_ORIGINS=http://localhost:5173
APP_FRONTEND_URL=http://localhost:5173
